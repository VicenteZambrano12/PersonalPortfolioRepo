# Copy this file to .env in the repository root and set your app URLs.
# VITE_ values are public and included in the frontend build; do not use secrets.

# PAUHelper live application URL
VITE_PAUHELPER_LIVE_URL=

# Orchestrator live application URL
VITE_ORCHESTRATOR_APP=

# Qdrant VM starter URL
VITE_QDRANT_VM_STARTER_URL=
